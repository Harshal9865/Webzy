# ==============================================================================
# WEBZY ENVIRONMENT VARIABLES TEMPLATE (NEVER COMMIT REAL SECRETS)
# Copy this file to `.env.local` for local dev, and configure separate keys in
# `staging` and `production` environments on your hosting dashboard.
# ==============================================================================

# 1. Environment & URLs (`local` | `staging` | `production`)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# 2. Supabase (Auth Magic Link + Postgres + Private Storage Bucket)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SEED_ADMIN_EMAIL=

# 3. Payment Provider (`mock` for dev/staging before Stage Go-Live, `razorpay` later)
PAYMENT_PROVIDER=mock
ALLOW_MOCK_IN_PROD=false
MOCK_WEBHOOK_SECRET=replace-with-local-mock-webhook-secret-min-32-chars

# Razorpay Keys (Leave blank in Phase 0; fill TEST keys on staging in Phase 4 / LIVE in Section 27)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 4. Transactional Email (Resend — also configure as Supabase Auth SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@webzy.in

# 5. Observability & Uptime Monitoring (Sentry + UptimeRobot)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
UPTIME_PING_SECRET=

# 6. Bot Protection & AI Helper (Server-side only — never expose AI keys to browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GEMINI_API_KEY=

# 7. Tax & Business Details (Single source of truth for invoices, policies & footer)
GST_REGISTERED=false
WEBZY_GSTIN=
WEBZY_BUSINESS_NAME=Webzy
WEBZY_BUSINESS_ADDRESS=Jaipur, Rajasthan, India
WEBZY_SUPPORT_EMAIL=support@webzy.in
WEBZY_SUPPORT_WHATSAPP=+919800000000
WEBZY_SUPPORT_HOURS=9:00 AM to 9:00 PM IST
WEBZY_GRIEVANCE_NAME=Founder Grievance Officer
WEBZY_GRIEVANCE_EMAIL=grievance@webzy.in

# 8. Feature Flags & Open-Question Defaults (Section 23 & Section 26)
DEFAULT_VALIDITY_DAYS=7
FEATURE_SCHEDULED_REVEAL=true
FEATURE_PIN_LOCK=true
FEATURE_OPENED_ALERT=false
FEATURE_OPENED_ALERT_PAID=false
FEATURE_MAAN_JAO=false

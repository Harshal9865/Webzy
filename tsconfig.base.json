{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@webzy/core": ["packages/core/src/index.ts"],
      "@webzy/core/*": ["packages/core/src/*"],
      "@webzy/themes": ["packages/themes/src/index.ts"],
      "@webzy/themes/*": ["packages/themes/src/*"],
      "@webzy/jobs": ["packages/jobs/src/index.ts"],
      "@webzy/jobs/*": ["packages/jobs/src/*"]
    }
  }
}
